# 이 파일을 .env 로 복사한 뒤 키를 입력하세요. (.env 는 git 에 올리지 않습니다)
# 공공데이터포털(data.go.kr) > "한국관광공사 국문 관광정보 서비스" 활용 신청 후 발급되는 인증키
TOUR_API_KEY=

# 공공데이터포털 > "한국문화정보원_한눈에보는문화정보조회서비스" (전시)
# 같은 계정이면 TOUR_API_KEY 와 같은 키라 비워 둬도 됩니다. 다른 키를 쓸 때만 입력하세요.
CULTURE_API_KEY=

# 공연예술통합전산망(kopis.or.kr) > OPEN API > 인증키 발급신청 (메일로 발급)
KOPIS_API_KEY=

# 카카오 개발자센터(developers.kakao.com) REST API 키 - 축제·전시 핫 판정용 (다음 블로그 검색)
KAKAO_REST_API_KEY=
